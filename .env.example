# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NODE_ENV is set by Next.js itself; do not define it here (a development value breaks `next build`).

# Database (Postgres 16 + PostGIS: local Docker in dev, Render Postgres in prod)
DATABASE_URL=postgres://glowy:glowy@localhost:5433/glowy

# Auth.js
AUTH_SECRET=replace_with_openssl_rand_base64_32
AUTH_GOOGLE_ID=replace_me
AUTH_GOOGLE_SECRET=replace_me

# Email (Resend)
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Glowy Homes <no-reply@glowy.homes>
# resend | log. "log" writes emails to .dev-mail and the console. Defaults to log when RESEND_API_KEY is unset.
EMAIL_TRANSPORT=log

# Maps and geocoding (MapTiler)
NEXT_PUBLIC_MAPTILER_KEY=replace_me
# Without a MapTiler key the map uses OpenFreeMap. Optional: another style URL, or "outline" for offline runs.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_STYLE=
MAPTILER_GEOCODING_KEY=replace_me

# Background jobs (Inngest)
INNGEST_EVENT_KEY=replace_me
INNGEST_SIGNING_KEY=replace_me

# Storage (Cloudflare R2, S3 compatible)
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=glowy-homes-media
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.glowy.homes

# Bot protection (Cloudflare Turnstile), leave blank in dev to skip
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Listing feed (only when CLAUDE.md listing_feed is not synthetic)
LISTING_FEED=synthetic
RESO_BASE_URL=
RESO_ACCESS_TOKEN=
CREA_DDF_CLIENT_ID=
CREA_DDF_CLIENT_SECRET=

# Payments (Phase 5 only; features hidden when blank)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI (optional). With a key, natural language search and neighbourhood summaries use the
# Anthropic API; without one they use the built in rule based parser and template.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Abuse limits, per IP per minute (writes default to half of RATE_LIMIT_PER_MINUTE),
# and sign in emails per address per hour.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WRITES_PER_MINUTE=30
SIGNIN_EMAILS_PER_HOUR=10
